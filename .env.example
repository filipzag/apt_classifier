OPENROUTER_API_KEY=
# Local LLM via Ollama (make llm-pull, make llm-check), used only when the server answers with
# LOCAL_LLM_FALLBACK_MODEL pulled. Without a key every remote model falls back to it (verifier,
# prose normaliser, interview phrasing, review); with a key only local/ model ids use it.
LOCAL_LLM_ENABLED=true
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_FALLBACK_MODEL=local/qwen3.5:4b-text
LOCAL_LLM_NUM_CTX=32768
# GPU only: refuse to load rather than run layers on the CPU; at most 2 CPU threads
LOCAL_LLM_GPU_ONLY=true
LOCAL_LLM_NUM_THREAD=2
# a local verifier's 'supported' below this P(supported) is left for the analyst
LOCAL_LLM_VERIFIER_MIN_CONFIDENCE=0.98
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
EMBEDDING_MODEL=basel/ATTACK-BERT
EMBEDDING_MODEL_REVISION=81e30f983a822c606825507b63ae318a6830a8a2
EXTRACT_MODEL=openai/gpt-5.6-sol
REVIEW_MODEL=anthropic/claude-sonnet-5
EXTRACT_EFFORT=low
QUESTION_EFFORT=medium
REVIEW_EFFORT=max
CYBERRE_MODEL=openai/gpt-5.6-sol
CYBERRE_EFFORT=low
ATTACK_VERSION=latest
SIMILARITY_THRESHOLD=0.45
RETRIEVAL_TOP_K=30
BEHAVIOR_SIMILARITY_THRESHOLD=0.55
BEHAVIOR_RETRIEVAL_TOP_K=20
TECHNIQUE_ACCEPTANCE_THRESHOLD=0.75
TECHNIQUE_RELATIVE_MARGIN=0.08
# Calibrated multi-label acceptance model (fit with: make fit-acceptance). Set to false to use
# the rule-based one-primary gate only.
ACCEPTANCE_MODEL_ENABLED=true
ACCEPTANCE_MODEL_PATH=data/models/acceptance/acceptance_model.json
# Same fit without exemplar features; used automatically when the primary model cannot run.
ACCEPTANCE_MODEL_FALLBACK_PATH=data/models/acceptance/acceptance_model_no_exemplars.json
# Labelled public report sentences (CC-BY-4.0, train splits) as acceptance evidence; build with
# `make exemplars`, then `make fit-acceptance`. Off restores the previous calibrated gate exactly.
TECHNIQUE_EXEMPLARS_ENABLED=true
TECHNIQUE_EXEMPLAR_INDEX_PATH=data/models/exemplars/exemplar_index.npz
TECHNIQUE_EXEMPLAR_K=64
TECHNIQUE_EXEMPLAR_TAU=0.05
TECHNIQUE_EXEMPLAR_DUPLICATE_SIMILARITY=0.95
TECHNIQUE_EXEMPLAR_NEW_CANDIDATES=3
# Rank each observation's candidates by the calibrated acceptance probability (see docs 8.3).
TECHNIQUE_RANK_BY_ACCEPTANCE=true
# Accept a technique left in review when >= N different observations of the case retrieved it with
# calibrated probability >= the floor (report-level corroboration); 0 disables.
TECHNIQUE_CORROBORATION_ACCEPT_OBSERVATIONS=2
TECHNIQUE_CORROBORATION_ACCEPT_MIN_PROBABILITY=0.1
# An observation that names an operating system ("on the Linux server") is mapped only to techniques
# documented for it, overriding the case's Target OS for that observation. The Target OS itself is
# chosen per case in Intake / Technique review (docs 5.7). On since 2026-10-01 (neutral on every
# benchmark, docs 21.3.12); false ignores operating systems named in the text.
TECHNIQUE_PLATFORM_FROM_TEXT=true
# Bonus per additional independent observation that accepted the same technique (max 3);
# 0 disables. Adopt only after the attribution benchmark shows a gain.
TECHNIQUE_CORROBORATION_BONUS=0.0
# LLM-generated observation sentences per technique (make generate-synthetic, then make ingest);
# indexed as the 'synthetic' field. false excludes them at retrieval time for comparison.
TECHNIQUE_INCLUDE_SYNTHETIC=false
SYNTHETIC_SENTENCES_PATH=data/kb/synthetic_sentences.json
# Judge long observations per sentence (own candidate pool and margins per sentence).
TECHNIQUE_SEGMENT_ACCEPTANCE=false
# Hierarchy consistency: swap_only | swap_and_fill | off. swap_only replaces an accepted
# sub-technique that is not separable from a plausible sibling with the parent technique.
TECHNIQUE_HIERARCHY_PARENT_MODE=off
MAX_QUESTIONS=10
# Interview questions about malware only one top-three group uses (docs 21.3.15 C), asked first
# while the case is not named; answers found / not found / not checked. A "not found" can only
# lower the leader's separation (by NEGATIVE_WEIGHT x rarity x exclusivity). Off until the
# pre-registered simulation passes (scripts/attribution_benchmark.py
# --simulate-software-interview enumerate).
INTERVIEW_SOFTWARE_QUESTIONS=false
INTERVIEW_SOFTWARE_PER_GROUP=1
INTERVIEW_SOFTWARE_MAX_QUESTIONS=3
INTERVIEW_SOFTWARE_MAX_USERS=1
INTERVIEW_SOFTWARE_WHEN_NAMED=false
INTERVIEW_SOFTWARE_NEGATIVE_WEIGHT=0.3
# A name must not rest on a "found" alone: without the interview software the leader's (or the
# cluster's) separation in the naming gate's window must be >= 0.
INTERVIEW_SOFTWARE_FOUND_REQUIRES_LEAD=true
THREAT_INTEL_DAYS=30
THREAT_INTEL_TIMEOUT=20.0
THREAT_INTEL_MAX_ITEMS_PER_SOURCE=100
INCLUDE_RANSOMWARE_CLAIMS=true
ELASTIC_MCP_URL=
ELASTIC_MCP_API_KEY=
ELASTIC_MCP_TIMEOUT=60.0
ELASTIC_MCP_LOOKBACK_HOURS=72
ELASTIC_MCP_MAX_RESULTS=20
ELASTIC_MCP_AUTO_GATHER=false
# Group-ensemble RRF constant (technique-level fusion uses TECHNIQUE_RRF_K).
RRF_K=20
TECHNIQUE_RRF_K=60
TECHNIQUE_MAPPING_PRESET=balanced
TECHNIQUE_RETRIEVAL_MODE=hybrid
TECHNIQUE_CANDIDATE_POOL=12
TECHNIQUE_INCLUDE_DETECTION=false
TECHNIQUE_PARENT_POLICY=ancestor_compatible
TECHNIQUE_VERIFIER_MODE=ambiguous
TECHNIQUE_VERIFIER_MODEL=openai/gpt-5.6-sol
TECHNIQUE_VERIFIER_EFFORT=low
RERANKER_ENABLED=false
RERANKER_MODEL=
# Remote reranker artifacts require a pinned repository revision. Local artifact
# directories must contain a valid apt_classifier_manifest.json.
RERANKER_MODEL_REVISION=
RERANKER_EXPECTED_BASE_MODEL=
RERANKER_EXPECTED_BASE_MODEL_REVISION=
RERANKER_EXPECTED_ARTIFACT_FINGERPRINT=
RERANKER_MAX_CANDIDATES=20
TECHNIQUE_FAMILY_WEIGHT=2.00
CONTEXT_FAMILY_WEIGHT=1.00
MOTIVATION_FAMILY_WEIGHT=1.50
ACTOR_BEHAVIOR_FAMILY_WEIGHT=1.50
SOFTWARE_FAMILY_WEIGHT=1.20
CAMPAIGN_FAMILY_WEIGHT=1.00
# Random-forest group and source-country models (make fit-forest; trained and run on the GPU when
# available, PROFILE_FOREST_DEVICE=cpu otherwise). The source-country vote is on by default since
# 2026-10-01 and needs the combiner fitted with it (attribution_combiner_0930_fsum.json). To turn it off set
# SOURCE_COUNTRY_WEIGHT=0.0 with ATTRIBUTION_COMBINER_PATH=data/models/combiner/attribution_combiner_no_country_fsum.json.
# The group forest stays at 0 (it hurt real reports; docs 21.3.11).
PROFILE_FOREST_ENABLED=true
PROFILE_FOREST_PATH=data/models/forest/profile_forest.npz
PROFILE_FOREST_DEVICE=auto
PROFILE_FOREST_WEIGHT=0.0
PROFILE_FOREST_FAMILY_WEIGHT=1.0
SOURCE_COUNTRY_WEIGHT=1.0
SOURCE_COUNTRY_FAMILY_WEIGHT=1.0
CYBERRE_WEIGHT=0.35
CYBERRE_FAMILY_WEIGHT=0.35
CYBERRE_MAX_RANKED_TECHNIQUES=50
CYBERRE_PREFILTER_TOP_K=50
CYBERRE_PREFILTER_ENABLED=true
SPECIFIC_BEHAVIOR_WEIGHT=1.50
NAIVE_BAYES_WEIGHT=1.00
IDF_OVERLAP_WEIGHT=1.00
JACCARD_WEIGHT=1.00
# Group-size normalisation exponent of the IDF cosine classifier (1.0 = full cosine; 0 = ignore size).
IDF_OVERLAP_LENGTH_NORM=1.0
# Soft technique evidence for the group ranking (near-miss candidates at their probability); 0 = off.
ATTRIBUTION_SOFT_EVIDENCE_MIN_PROBABILITY=0.0
ATTRIBUTION_SOFT_EVIDENCE_WEIGHT=1.0
ATTRIBUTION_SOFT_EVIDENCE_MAX_GROUPS=0
CAMPAIGN_WEIGHT=0.00
GROUP_DESCRIPTION_WEIGHT=0.40
SEMANTIC_CENTROID_WEIGHT=0.70
STRATEGIC_CONTEXT_WEIGHT=0.70
MOTIVATION_WEIGHT=1.50
SOFTWARE_WEIGHT=1.20
# Weight observed tools by rarity across ATT&CK groups (commodity tools count less).
SOFTWARE_IDF_ENABLED=true
# ATT&CK 'tool' entries (admin utilities) are capped at this rarity weight; malware keeps full rarity.
SOFTWARE_TOOL_WEIGHT_CAP=1.5
# Multiplier on the software vote when the case names malware documented for <=2 groups (half for <=4).
SOFTWARE_DECISIVE_BOOST=2.0
NB_ALPHA=0.60
NB_BETA=0.05
NEGATIVE_EVIDENCE_WEIGHT=0.30
POSTERIOR_TEMPERATURE=2.0
# Telemetry-aware negative evidence: discount negative interview answers for techniques whose
# telemetry is not collected. Requires a TelemetryProfile set through
# AttributionEngine.set_telemetry_profile (no UI yet); without a profile all negatives count.
TELEMETRY_VALIDATION_ENABLED=true
# Attribution stages and calibrated rejection
ATTRIBUTION_MIN_TECHNIQUES=2
ATTRIBUTION_MIN_INDEPENDENT_FAMILIES=2
ATTRIBUTION_MIN_MATURITY=0.5
# Raised from 0.7 after the attribution benchmark showed named hypotheses were wrong 55% of
# the time at 0.7 and 6% at 0.78 (docs/TECHNICAL_DOCUMENTATION.md 21.3.5).
ATTRIBUTION_HYPOTHESIS_MATURITY=0.82
ATTRIBUTION_HYPOTHESIS_MARGIN=0.10
# Candidate-relative separation (docs 10.7). Gate mode: separation (default) | maturity | both.
ATTRIBUTION_GATE_MODE=separation
ATTRIBUTION_SEPARATION_TOP_K=5
ATTRIBUTION_SEPARATION_TECHNIQUE_WEIGHT=1.0
ATTRIBUTION_SEPARATION_BEHAVIOR_WEIGHT=2.0
ATTRIBUTION_SEPARATION_SOFTWARE_WEIGHT=1.0
ATTRIBUTION_SEPARATION_NEGATIVE_WEIGHT=0.3
ATTRIBUTION_SEPARATION_FLOOR=1.0
ATTRIBUTION_HYPOTHESIS_SEPARATION=0.5
ATTRIBUTION_HYPOTHESIS_MIN_DISCRIMINATIVE=3.0
ATTRIBUTION_HYPOTHESIS_SPECIFICITY=0.0
ATTRIBUTION_RERANK_BLEND=0.5
# Shortlist size for the discriminative re-ranking; 0 = same as ATTRIBUTION_SEPARATION_TOP_K.
# 10 re-ranks the top ten while the naming gate keeps scoring five (adopted 2026-09-29).
ATTRIBUTION_RERANK_TOP_K=10
# Contrastive near misses: unaccepted candidates with acceptance probability >= this enter the
# separation's soft channel (exclusivity- and specificity-weighted, never a classifier vote).
# 0 disables; off until measured on both attribution benchmarks.
ATTRIBUTION_CONTRAST_MIN_PROBABILITY=0.0
ATTRIBUTION_CONTRAST_WEIGHT=1.0
ATTRIBUTION_SEPARATION_SOFT_WEIGHT=1.0
# Learned combiner over the shortlist (make fit-combiner writes the artifact; adopted 2026-09-30:
# half blend with the RRF order, naming gate scored against the union of both shortlists).
ATTRIBUTION_COMBINER_ENABLED=true
ATTRIBUTION_COMBINER_PATH=data/models/combiner/attribution_combiner_0930_fsum.json
ATTRIBUTION_COMBINER_TOP_N=20
ATTRIBUTION_COMBINER_BLEND=0.5
# Documented-overlap clusters: when the single leader fails the naming gate (or has a nested
# ATT&CK twin), name the pair as "A / B (documented overlap)" if the pair clears the separation
# bar against the rest, its exclusive mass and combined combiner probability (docs 21.3.15;
# on since the documented scope passed on fresh seeds 59/61, A′). Scope: "documented" = ATT&CK
# documents the pair as the same or overlapping activity (reviewed table, attack/same_activity.py)
# or one profile contains the other; groups that only share rare malware or that ATT&CK calls
# distinct are never named together. "full" = any ATT&CK relation; "nested" = containing profiles.
ATTRIBUTION_CLUSTER_NAMING=true
ATTRIBUTION_CLUSTER_MIN_PROBABILITY=0.8
ATTRIBUTION_CLUSTER_MIN_DISCRIMINATIVE=3.5
ATTRIBUTION_CLUSTER_SCOPE=documented
# Calibrated confidence labels on the Top-three view (display only, never a gate; pinned to the
# combiner artifact above; adopted 2026-10-02, docs 21.3.15). Refit with make fit-confidence-labels
# after make fit-combiner; labels are hidden when the artifact does not match the combiner.
CONFIDENCE_LABELS_ENABLED=true
CONFIDENCE_LABELS_PATH=data/models/calibration/confidence_labels_fsum.json
# Opt-in local longitudinal activity clustering (disabled by default)
ACTIVITY_CLUSTERS_ENABLED=false
ACTIVITY_CLUSTERS_DB_PATH=data/activity_clusters.db
ACTIVITY_CLUSTERS_MIN_SIMILARITY=0.3

# ----- Users and sign-in (web app) -----
# AUTH_MODE=auto enables Google sign-in when GOOGLE_CLIENT_ID is set and runs as one local
# analyst otherwise; "off" and "google" force either. Google Cloud console -> APIs & Services ->
# Credentials -> OAuth client ID (Web application); authorised redirect URIs:
#   http://127.0.0.1:5173/auth/callback   (Vite dev server)
#   http://127.0.0.1:8100/auth/callback   (API serving the built app)
#   https://<your host>/auth/callback     (production; also set AUTH_PUBLIC_URL)
AUTH_MODE=auto
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
# Who may sign in (required in google mode): comma-separated domains and/or addresses.
AUTH_ALLOWED_DOMAINS=example.com
AUTH_ALLOWED_EMAILS=
# Administrators (comma-separated addresses); the first user to sign in is an admin too.
AUTH_ADMIN_EMAILS=
AUTH_SESSION_HOURS=8
AUTH_COOKIE_SECURE=false
AUTH_PUBLIC_URL=

# The fine-tuned technique head (apt_classifier/technique_head.py, docs 21.3.18): a local service
# (`make technique-head-serve`, GPU, about 3.5 GB) scoring every observation with the 4B technique
# model. Off by default until the pre-registered gate passes; fail closed when the service is down.
TECHNIQUE_HEAD_ENABLED=false
TECHNIQUE_HEAD_URL=http://localhost:8102
# SHA-256 the service reports at /health; empty accepts any checkpoint
TECHNIQUE_HEAD_EXPECTED_FINGERPRINT=
TECHNIQUE_HEAD_TOP_FAMILIES=3
TECHNIQUE_HEAD_NEW_CANDIDATES=3

ACCEPTANCE_MODEL_HEAD_PATH=data/models/acceptance/acceptance_model_technique_head.json
